<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">

    <title>JAGS: Just Another Gibbs Sampler</title>
    <organization>com.matthewdenwood</organization>

    <welcome file="Welcome.html"/>
    <license file="License.rtf"/>
    <conclusion file="Conclusion.html"/>

    <options
        customize="allow"
        require-scripts="true"
        hostArchitectures="arm64,x86_64"
        rootVolumeOnly="true" />
    
    <volume-check>
      <allowed-os-versions>
        <os-version min="11.0"/>
      </allowed-os-versions>
    </volume-check>
 
    <choices-outline>
        <line choice="utils"/>
        <line choice="transition"/>
        <line choice="jags-4-vsu"/>
        <line choice="jags-5-rsu"/>
        <line choice="jags-5-vsu"/>
        <line choice="jags-5-vgu"/>
    </choices-outline>

    <choice
        id="utils"
        title="JAGS utils"
        description="Utilities scripts and pkgconf-lite"
        visible="true"
        exclusive="false"
        selected="true"
        enabled="false" >
        <pkg-ref id="com.matthewdenwood.jags-utils"/>
    </choice>
    
    <choice
        id="transition"
        title="JAGS transition"
        description="Transition framework from JAGS 4.x to 5.x"
        visible="true"
        exclusive="false"
        selected="choices['transition'].selected === undefined ? true : choices['transition'].selected" >
        <pkg-ref id="com.matthewdenwood.jags-transition"/>
    </choice>

    <choice
        id="jags-4-vsu"
        title="JAGS 4.3.2-vecLib-single-universal"
        description="JAGS 4.3.2 re-compiled for use within the new /opt/jags/ installation directory"
        visible="true"
        exclusive="false"
        selected="choices['jags-4-vsu'].selected === undefined ? true : choices['jags-4-vsu'].selected" >
        <pkg-ref id="com.matthewdenwood.jags-4-vsu"/>
    </choice>

    <choice
        id="jags-5-rsu"
        title="JAGS 5.0.0-refBLAS-single-universal"
        description="JAGS built with reference BLAS/LAPACK and single threading"
        visible="true"
        exclusive="false"
        selected="choices['jags-5-rsu'].selected === undefined ? true : choices['jags-5-rsu'].selected" >
        <pkg-ref id="com.matthewdenwood.jags-5-rsu"/>
    </choice>

    <choice
        id="jags-5-vsu"
        title="JAGS 5.0.0-vecLib-single-universal"
        description="JAGS built with Apple's Accelerate framework and single threading"
        visible="true"
        exclusive="false"
        selected="choices['jags-5-vsu'].selected === undefined ? true : choices['jags-5-vsu'].selected" >
        <pkg-ref id="com.matthewdenwood.jags-5-vsu"/>
    </choice>
    
    <choice
        id="jags-5-vgu"
        title="JAGS 5.0.0-vecLib-gcd-universal"
        description="JAGS built with Apple's Accelerate framework and multi-threading using Grand Central Dispatch (GCD)"
        visible="true"
        exclusive="false"
        selected="choices['jags-5-vgu'].selected === undefined ? true : choices['jags-5-vgu'].selected" >
        <pkg-ref id="com.matthewdenwood.jags-5-vgu"/>
    </choice>
    
    <pkg-ref
        id="com.matthewdenwood.jags-transition"
        version="1.0.0" >
        transition-1.0.0.pkg
    </pkg-ref>

    <pkg-ref
        id="com.matthewdenwood.jags-utils"
        version="1.0.0" >
        utils-1.0.0.pkg
    </pkg-ref>

    <pkg-ref
        id="com.matthewdenwood.jags-4-vsu"
        version="4.3.2" >
        JAGS-4.3.2-vecLib-single-universal.pkg
    </pkg-ref>

    <pkg-ref
        id="com.matthewdenwood.jags-5-rsu"
        version="5.0.0" >
        JAGS-5.0.0-refBLAS-single-universal.pkg
    </pkg-ref>

    <pkg-ref
        id="com.matthewdenwood.jags-5-vsu"
        version="5.0.0" >
        pkg/JAGS-5.0.0-vecLib-single-universal.pkg
    </pkg-ref>

    <pkg-ref
        id="com.matthewdenwood.jags-5-vgu"
        version="5.0.0" >
        pkg/JAGS-5.0.0-vecLib-gcd-universal.pkg
    </pkg-ref>

</installer-gui-script>
